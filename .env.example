# 开发配置见 .env.development，正式配置见 .env.production。
# 此文件仅用于复制环境变量模板，不会被 Vite 自动加载。
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://api.firebulls.cn:8443

# Sentry 客户端配置。DSN 可公开，但生产环境建议只在正式配置中填写。
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_API_ERROR_SAMPLE_RATE=0
VITE_SENTRY_CHUNK_ERROR_SAMPLE_RATE=0
VITE_SENTRY_TEST_ENABLED=false

# Source Map 上传参数只注入 CI/发布环境，不要提交真实令牌。
SENTRY_SOURCE_MAP_UPLOAD=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
