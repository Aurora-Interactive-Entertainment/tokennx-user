  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run size:check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
