VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://api.firebulls.cn:8443
# VITE_API_PROXY_TARGET=http://192.168.7.111:8081

# 本地默认关闭 Sentry，必要时临时填写 DSN 并开启测试入口。
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_API_ERROR_SAMPLE_RATE=0
VITE_SENTRY_CHUNK_ERROR_SAMPLE_RATE=0
VITE_SENTRY_TEST_ENABLED=false
